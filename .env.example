APP_NAME=Generative Infinite Deception Maze
APP_ENV=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

HONEYPOT_BIND_HOST=0.0.0.0
HONEYPOT_PORTS=2222,2323
HONEYPOT_PROTOCOLS=ssh,tcp
HONEYPOT_READ_TIMEOUT_SECONDS=45
HONEYPOT_WRITE_PROMPT=maze@corp-gateway:~$ 
HONEYPOT_SSH_BANNER=SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.6
SESSION_MEMORY_WINDOW=12
SYNTHETIC_SUBNET=10.0.5.0/24
DEFAULT_PERSONA=compromised_linux_terminal

DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_TIMEOUT_SECONDS=45
DASHSCOPE_MAX_RETRIES=4
DASHSCOPE_RETRY_BASE_SECONDS=1.25
DASHSCOPE_TEMPERATURE=0.25
DASHSCOPE_TOP_P=0.85

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please_change_me
NEO4J_DATABASE=neo4j
NEO4J_ENCRYPTED=false

OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

MCP_TRAP_TOKEN=maze-trap-token
PREEMPTIVE_ACTION_MODE=simulate
ALERT_SEVERITY_THRESHOLD=high
